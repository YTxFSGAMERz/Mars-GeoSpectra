# MARS-GEOSPECTRA Environment Configuration
# Copy this file to .env for local development

# Optional Backend API URL (defaults to client-side isomorphic processing if unset)
VITE_API_URL=http://localhost:8000

# Optional NASA API Key for higher rate limits (defaults to DEMO_KEY if unset)
# NASA Open APIs: https://api.nasa.gov
VITE_NASA_API_KEY=DEMO_KEY

# Optional Cesium Ion Token (if using Cesium Ion assets; not required for public Mars WMTS/open tiles)
VITE_CESIUM_ION_TOKEN=

# Mission Environment Mode: "demo" | "hybrid" | "live"
VITE_MISSION_MODE=demo

# Server-Side Only Secrets (Do NOT expose with VITE_ prefix)
# GEMINI_API_KEY=your_gemini_api_key_here
